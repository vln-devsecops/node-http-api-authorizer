{
  "name": "@vln-devsecops/http-api-authorizer-lambda",
  "license": "Apache-2.0",
  "version": "1.1.0",
  "type": "module",
  "description": "Reusable API Gateway v2 Lambda REQUEST authorizer: verifies a CloudFront origin-verify secret header, and optionally a JWT (via jose) against a caller-supplied issuer/audience, forwarding selected claims into the authorizer context.",
  "files": [
    "dist/"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && node esbuild.config.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "oxlint ."
  },
  "dependencies": {
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.163",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^5.0.0",
    "esbuild": "^0.28.2",
    "oxlint": "^1.82.0",
    "typescript": "~7.0.2",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
